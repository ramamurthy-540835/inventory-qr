rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /products/{productId} { allow read: if resource.data.active == true || admin(); allow write: if admin(); }
    match /categories/{categoryId} { allow read: if resource.data.active == true || admin(); allow write: if admin(); }
    match /brands/{id} { allow read: if true; allow write: if admin(); }
    match /offers/{id} { allow read: if true; allow write: if admin(); }
    match /delivery_zones/{id} { allow read: if true; allow write: if admin(); }
    match /delivery_slots/{id} { allow read: if true; allow write: if admin(); }
    match /users/{userId} { allow read, write: if owns(userId) || admin(); }
    match /customers/{userId} { allow read, write: if owns(userId) || admin(); }
    match /addresses/{userId}/{addressId} { allow read, write: if owns(userId) || admin(); }
    match /cart/{userId} { allow read, write: if owns(userId) || admin(); }
    match /wishlist/{userId}/{itemId} { allow read, write: if owns(userId) || admin(); }
    match /notifications/{userId}/{notificationId} { allow read, write: if owns(userId) || admin(); }
    match /orders/{orderId} { allow read, write: if signedIn() && (resource.data.customerId == request.auth.uid || admin()); }
    match /payments/{paymentId} { allow read, write: if signedIn() && (resource.data.customerId == request.auth.uid || admin()); }
    match /reviews/{reviewId} { allow read, write: if signedIn() && (resource.data.customerId == request.auth.uid || admin()); }
    match /support_tickets/{ticketId} { allow read, write: if signedIn() && (resource.data.customerId == request.auth.uid || admin()); }
    match /inventory/{id} { allow read, write: if admin(); }
    match /coupons/{id} { allow read, write: if admin(); }
    match /stores/{id} { allow read, write: if admin(); }
    match /delivery_partners/{id} { allow read, write: if admin(); }
    match /audit_logs/{id} { allow read, write: if admin(); }
  }
}
